# Admin panel password — REQUIRED. There is no default password.
# If ADMIN_PASSWORD is not set, admin login is disabled entirely.
# Set a long, random password in Vercel → Settings → Environment Variables,
# then redeploy. Never commit a real password to GitHub.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Your Amazon Associates Tag, e.g. zaypick-20
# The admin Settings page can also set this.
NEXT_PUBLIC_AMAZON_TAG=zaypick-20

# Optional: Amazon Product Advertising API (price auto-refresh)
# Leave blank for now — Refresh Prices will show "not connected".
# Do NOT build auto price update until you have PA-API access.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_API_PARTNER_TAG=zaypick-20
